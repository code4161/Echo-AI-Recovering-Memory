# Copy to .env and adjust. .env is git-ignored.

NODE_ENV=development
PORT=4000

# Matches database/docker-compose.yml
DATABASE_URL=postgresql://echo:echo@localhost:5432/echo

# Origin allowed to call the API and open a Socket.io connection.
CLIENT_ORIGIN=http://localhost:5173

# Which implementation generates Echo's dialogue.
# "rules" is the built-in keyword engine and needs no key.
# See backend/src/services/echo/README.md to add a model-backed provider.
AI_PROVIDER=rules
AI_API_KEY=
