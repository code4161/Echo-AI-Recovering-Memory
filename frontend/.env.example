# Copy to .env.local (git-ignored). Only VITE_* variables reach the browser.

# Leave both empty in development: vite.config.ts proxies /api and /socket.io
# to http://localhost:4000, so the app stays same-origin.
# In production set them to the deployed backend origin.
VITE_API_URL=
VITE_SOCKET_URL=

# Set to true to skip the backend entirely and play against the in-browser
# rules engine. Useful for UI work without running Postgres.
VITE_OFFLINE=false
